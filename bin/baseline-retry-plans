#!/usr/bin/env ruby
require "json"

if ARGV.size != 2 || !ARGV.all? { |argument| argument.match?(/\A[0-9]+\z/) }
  abort "Usage: #{$PROGRAM_NAME} SEED TRIALS (nonnegative seed, positive trial count)"
end

seed, trial_count = ARGV.map { |argument| Integer(argument, 10) }
abort "TRIALS must be positive" unless trial_count.positive?

def reservation_case(initial_stock:, id:, quantity:, initial_response:, retries:)
  request = { reservation_id: id, quantity: quantity }
  initial_attempt = { request: request, response_mode: initial_response }
  retry_attempts = Array.new(retries) { { request: request, response_mode: "receive" } }
  { initial_stock: initial_stock, attempts: [initial_attempt, *retry_attempts] }
end

random = Random.new(seed)
cases = Array.new(trial_count) do
  initial_stock = random.rand(1..5)
  reservation_case(
    initial_stock: initial_stock,
    id: "reservation-#{random.rand(1..999_999)}",
    quantity: random.rand(1..initial_stock),
    initial_response: random.rand(2).zero? ? "receive" : "drop_after_commit",
    retries: random.rand(1..3)
  )
end
reference_case = reservation_case(
  initial_stock: 2, id: "reservation-1", quantity: 1,
  initial_response: "drop_after_commit", retries: 1
)

puts JSON.pretty_generate(
  schema_version: 1, seed: seed, trial_count: trial_count,
  reference_case: reference_case, cases: cases
)
